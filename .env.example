# MARKET RADAR AI — environment template.
# PLACEHOLDERS ONLY. Never commit a real key to this file.
# Copy to .env.local (git-ignored) and fill in.
#
# A key being present here is NEVER treated as proof that a provider is LIVE:
# every provider is probed with a real request before it is reported as connected.

# ---- Application mode: DEMO | HYBRID | LIVE ----
APP_MODE=HYBRID

# ---- Real AI analysis (Anthropic) ----
# Without this the agents report NOT_AVAILABLE. They never fabricate analysis instead.
AI_API_KEY=
# Optional model override (default: claude-opus-5)
AI_MODEL=

# ---- Supabase ----
# Use the PROJECT ROOT url, e.g. https://<project-ref>.supabase.co
# (a trailing /rest/v1 is stripped automatically, but the root form is correct).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Search providers ----
# Google Programmable Search: the Custom Search JSON API must be ENABLED on the
# Google Cloud project, otherwise the API answers 403 and the provider is OFFLINE.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_DAILY_QUOTA=100

# NewsAPI (optional)
NEWSAPI_KEY=
NEWSAPI_DAILY_QUOTA=100

# X / Twitter API v2 (optional). Without it, direct-quote verification is NOT_AVAILABLE.
X_API_BEARER_TOKEN=
X_DAILY_QUOTA=100

# Keyless search providers need no configuration:
#   Google News RSS · GDELT · SEC EDGAR · RSS feeds · official/government feeds
# Optional feed overrides (comma-separated URLs):
RSS_FEEDS=
OFFICIAL_FEEDS=
# SEC requires a descriptive User-Agent; set your own contact string.
PUBLIC_USER_AGENT=

# ---- Market data ----
# Adapter: polygon | finnhub | alphavantage. Falls back to keyless Yahoo Finance
# (real data) when the chosen vendor has no key — never to generated prices.
MARKET_DATA_PROVIDER=polygon
MARKET_DATA_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ---- Macro / crypto ----
COINGECKO_API_KEY=
FRED_API_KEY=

# ---- Optional. Must NOT block the application. ----
TRANSLATION_API_KEY=

# ---- Protects /api/cron/scan. Vercel sends it as `Authorization: Bearer $CRON_SECRET`. ----
CRON_SECRET=
